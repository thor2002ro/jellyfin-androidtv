<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/overscan_horizontal"
    android:paddingBottom="@dimen/overscan_vertical">

    <TextView
        android:id="@+id/notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/red_gradient_end"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/white"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/Widget.Jellyfin.Row.Header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/who_is_watching"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@id/no_users_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/notification"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/no_users_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/no_user_warning"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/users"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/users"
        android:layout_width="wrap_content"
        android:layout_height="139dp"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusDown="@id/server_button"
        android:scrollbars="none"
        app:focusOutFront="true"
        app:focusOutEnd="true"
        app:layout_constraintBottom_toTopOf="@id/server_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/no_users_warning"
        tools:itemCount="4"
        tools:listitem="@layout/view_card_default" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/server_button"
        style="@style/Button.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:drawableStart="@drawable/ic_house_edit"
        android:maxLines="1"
        android:ellipsize="end"
        android:minHeight="48dp"
        android:nextFocusUp="@id/users"
        android:textAllCaps="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/login_disclaimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/users"
        tools:text="Home server" />

    <org.jellyfin.androidtv.ui.ExpandableTextView
        android:id="@+id/login_disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/server_button"
        app:layout_constraintWidth_max="500dp"
        tools:text="This is the login disclaimer." />
</androidx.constraintlayout.widget.ConstraintLayout>
