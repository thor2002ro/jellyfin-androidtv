<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/rowsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/infoRow"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="50sp"
        android:layout_marginTop="20sp"
        android:layout_marginEnd="10sp"
        android:layout_toStartOf="@+id/npBug"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:textSize="32sp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="20sp"
        android:layout_below="@+id/title"
        android:layout_alignStart="@+id/title"
        android:layout_marginTop="5sp"
        android:id="@+id/infoRow"
        android:layout_toStartOf="@+id/clock"/>

    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:alpha=".75"
        android:dividerPadding="4dp"
        android:gravity="bottom|end"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/verticalToolBar"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@+id/rowsFragment"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:alpha=".75"
        android:dividerPadding="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:showDividers="middle"
        android:visibility="gone" />

    <org.jellyfin.androidtv.ui.AlphaPickerView
        android:id="@+id/alphaPickerHorizontal"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/statusText"
        android:layout_toStartOf="@+id/counter"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <org.jellyfin.androidtv.ui.AlphaPickerView
        android:id="@+id/alphaPickerVertical"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@+id/rowsFragment"
        android:layout_alignBottom="@+id/rowsFragment"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0 | 0"
        android:id="@+id/counter"
        android:textAlignment="viewEnd"
        android:textSize="18sp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="0dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/statusText"
        android:maxWidth="360dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="12sp"
        android:alpha=".6"
        android:layout_alignStart="@+id/title"
        android:layout_alignBaseline="@+id/counter"
        android:fontFamily="sans-serif-light" />

    <org.jellyfin.androidtv.ui.ClockUserView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/clock"
        android:layout_alignTop="@+id/title"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="8sp"
        android:layout_alignParentEnd="true" />

    <org.jellyfin.androidtv.ui.NowPlayingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/npBug"
        android:layout_toStartOf="@+id/clock"
        android:layout_alignTop="@+id/clock"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/filters"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
